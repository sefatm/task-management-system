            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          }
        },
        {
          "name": "Update task (MANAGER)",
          "request": {
            "method": "PUT",
            "header": [
