            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write release notes\",\n  \"description\": \"For v1.0\",\n  \"deadline\": \"2030-12-31\",\n  \"priority\": \"HIGH\",\n  \"assignedTo\": 3\n}"
            }
          }
        }
      ]
    },
